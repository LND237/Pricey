{
  "expo": {
    "name": "Pricey",
    "slug": "pricey",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "pricey",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pricey.app"
    },
    "android": {
      "package": "com.pricey.app",
      "adaptiveIcon": {
        "backgroundColor": "#ffffff"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "root": "./src/ui/app"
      }
    }
  }
}
